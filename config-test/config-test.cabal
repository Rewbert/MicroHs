cabal-version:      3.0
name:               config-test
version:            0.1.0.0
-- synopsis:
-- description:
license:            BSD-3-Clause
license-file:       LICENSE
author:             Rewbert
maintainer:         krookr@chalmers.se
-- copyright:
build-type:         Simple
extra-doc-files:    CHANGELOG.md
-- extra-source-files:

common warnings
    ghc-options: -Wall

library
    import:           warnings
    exposed-modules:  Config
    -- other-modules:
    -- other-extensions:
    build-depends:    base ^>=4.22.0.0,
                      QuickCheck,
                      text,
                      process,
                      filepath,
                      directory
    hs-source-dirs:   src
    default-language: Haskell2010

executable config-test
    import:           warnings
    main-is:          Main.hs
    -- other-modules:
    -- other-extensions:
    build-depends:    base ^>=4.22.0.0,
                      config-test,
                      QuickCheck
    hs-source-dirs:   app
    default-language: Haskell2010
